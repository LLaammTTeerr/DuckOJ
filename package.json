{
  "name": "duckoj",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "lint": "pnpm -r lint",
    "lint:scripts": "eslint scripts",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "verify": "pnpm -r typecheck && pnpm run typecheck:scripts && pnpm -r lint && pnpm run lint:scripts && pnpm -r test && pnpm --filter @duckoj/contracts openapi && pnpm --filter @duckoj/sdk exec openapi-typescript ../../openapi.json -o src/generated.ts && git diff --exit-code -- openapi.json packages/sdk/src/generated.ts && pnpm --filter @duckoj/web exec vite build",
    "seed": "tsx scripts/seed-problem.ts",
    "package:build": "tsx scripts/package-build.ts",
    "polygon:import": "tsx scripts/polygon-import.ts",
    "prepare:problem": "tsx scripts/prepare.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "judge:node": "tsx scripts/judge-node.ts",
    "org:import": "tsx scripts/org-import.ts"
  },
  "dependencies": {
    "@duckoj/contracts": "workspace:*",
    "@duckoj/db": "workspace:*",
    "@duckoj/package-format": "workspace:*",
    "@duckoj/polygon-import": "workspace:*",
    "@duckoj/prepare": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^9",
    "typescript-eslint": "^8",
    "prettier": "^3",
    "tsx": "^4.23.12",
    "typescript": "^5.6",
    "vitest": "^2"
  }
}
