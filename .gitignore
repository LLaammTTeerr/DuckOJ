# Python bytecode from content/ generators
__pycache__/

# Generated operator secrets — never committed
.secrets/

# Playwright journey screenshots — evidence, regenerated every run
apps/web/e2e/screenshots/

# scripts/deploy.sh's marker — the sha of the last deploy that PASSED its
# poll, which is how it decides whether packages/db/migrations moved. Local
# to a host, never shared: two machines deploy different things at different
# times, and a committed marker would tell one of them to skip a migration
# the other already ran.
.deploy/
# `corepack pnpm prepare <dir>` writes its gate report beside the problem it
# checked. It is evidence of one run on one machine, regenerated every time —
# committing it would put a timestamp and local paths into the problem source.
prepare-report.json
