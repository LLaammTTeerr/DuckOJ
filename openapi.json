                    "hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "sizeBytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "fileCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "hash",
                    "sizeBytes",
                    "fileCount",
                    "createdAt"
                  ]
