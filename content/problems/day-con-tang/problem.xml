<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
  A Polygon "full" package descriptor, hand-written for this repo's demo
  content rather than exported by Polygon. It is the exact slice
  packages/polygon-import/src/parse.ts reads: a testset named "tests", the
  time limit in MILLISECONDS, the memory limit in BYTES, a test-count that
  must agree with the <tests> list, 1-indexed %02d path patterns, and groups
  with no <dependencies> (which the importer refuses rather than dropping).

  No <checker> asset: every test's answer is a single integer, so the
  standard token comparison is the whole of what a wcmp-style checker would
  do. The importer maps a checkerless package to {"kind":"standard"}.
-->
<problem revision="1" short-name="day-con-tang" url="">
  <names>
    <name language="vietnamese" value="Dãy con tăng dài nhất"/>
    <name language="english" value="Longest increasing subsequence"/>
  </names>
  <statements>
    <statement charset="UTF-8" language="vietnamese" mathjax="true" path="statement.md" type="text/markdown"/>
  </statements>
  <judging input-file="" output-file="">
    <testset name="tests">
      <time-limit>2000</time-limit>
      <memory-limit>268435456</memory-limit>
      <test-count>12</test-count>
      <input-path-pattern>tests/%02d</input-path-pattern>
      <answer-path-pattern>tests/%02d.a</answer-path-pattern>
      <tests>
        <test method="manual" sample="true" points="0" group="samples"/>
        <test method="manual" sample="true" points="0" group="samples"/>
        <test method="generated" sample="false" points="8" group="nho"/>
        <test method="generated" sample="false" points="8" group="nho"/>
        <test method="generated" sample="false" points="8" group="nho"/>
        <test method="generated" sample="false" points="8" group="nho"/>
        <test method="generated" sample="false" points="8" group="nho"/>
        <test method="generated" sample="false" points="12" group="lon"/>
        <test method="generated" sample="false" points="12" group="lon"/>
        <test method="generated" sample="false" points="12" group="lon"/>
        <test method="generated" sample="false" points="12" group="lon"/>
        <test method="generated" sample="false" points="12" group="lon"/>
      </tests>
      <groups>
        <group name="samples" points="0" points-policy="each-test" feedback-policy="complete"/>
        <group name="nho" points="40" points-policy="each-test" feedback-policy="icpc"/>
        <group name="lon" points="60" points-policy="each-test" feedback-policy="icpc"/>
      </groups>
    </testset>
  </judging>
  <assets>
    <solutions>
      <solution tag="main">
        <source path="solution.cpp" type="cpp.g++17"/>
      </solution>
    </solutions>
  </assets>
</problem>
