{$SITE_ADDRESS:localhost} {
	encode gzip zstd

	# Security response headers, applied to EVERY response Caddy serves — the
	# proxied API, the docs viewer and the SPA alike. Set at the edge rather
	# than in the app because the SPA's `index.html` is served by `file_server`
	# below and never touches Node, so a header the API sets would miss exactly
	# the document that runs author-controlled statement HTML (see
	# apps/web/src/markdown.ts). The Content-Security-Policy is NOT here: it is
	# scoped to the SPA `handle` block, because the Scalar docs viewer under
	# /api/v1/docs needs a laxer one and the JSON API needs none.
	#
	# `test/security-headers.spec.ts` (apps/api) pins every line below by
	# reading this file, the same way proxy-keepalive.spec.ts pins `keepalive`.
	header {
		# HSTS: ignored by browsers over plain HTTP (localhost dev), enforced
		# over the HTTPS the tag deployment terminates. One year, subdomains.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Stops a browser from MIME-sniffing a response into a type it was not
		# sent as — the classic "upload a .txt that sniffs to text/html" XSS.
		X-Content-Type-Options "nosniff"
		# A statement page carries a token in no URL, but the referrer of an
		# outbound link in a problem statement should not leak the full path.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Clickjacking: no framing at all. `frame-ancestors 'none'` in the SPA
		# CSP is the modern half; this covers browsers that predate it.
		X-Frame-Options "DENY"
		# Version/tech disclosure. Express' own `x-powered-by` is also disabled
		# in app.setup.ts; stripping it here covers it at the edge regardless.
		-X-Powered-By
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000 {
			# A dial failure must not become a 502. `reverse_proxy api:3000`
			# dials a *hostname*, so Go re-resolves `api` against podman's
			# aardvark-dns on every dial that cannot reuse a pooled
			# connection — and one SERVFAIL is one gateway error for a
			# request the API was up and ready to answer. Caddy wrote nothing
			# upstream in that case, so retrying is unconditionally safe, and
			# each retry re-resolves the name. Without this the access log
			# carried 897 gateway errors in a day: 896 `connection refused`
			# while the api container was being recreated, and the one
			# `lookup api ... server misbehaving` on /api/v1/submissions/NaN
			# that B4 reported as an unexplained 502.
			lb_try_duration 10s
			lb_try_interval 250ms

			# Every proxy to `api` keeps its own pool of idle upstream
			# connections. Caddy's default is to hold one for 2 minutes, while
			# Node's `http.Server.keepAliveTimeout` closes it far sooner — so
			# the proxy is the last to know, and a request written onto a
			# connection the server is closing in the same instant dies as a
			# 502 for a request the API would have answered. `app.setup.ts`
			# now holds the server side open for 185s; this is the other half,
			# stated explicitly so the invariant (proxy idle < server idle)
			# does not rest on a default this repo cannot see.
			transport http {
				keepalive 60s
			}
		}
	}

	# The WebSocket upgrade endpoint SubmissionsGateway listens on
	# (apps/api/src/realtime/submissions.gateway.ts). Without this handle,
	# a request to /ws falls through to the SPA catch-all below, which
	# answers `try_files ... /index.html` — a plain 200 with an HTML body,
	# not a 101 Switching Protocols. That silently breaks the live-update
	# path for every real browser (which only ever reaches the API through
	# Caddy) while a client talking to the API container directly still
	# works, masking the break. Caddy's reverse_proxy handles the WebSocket
	# upgrade natively; no extra directives are needed beyond routing here.
	handle /ws {
		reverse_proxy api:3000 {
			# Both policies are per-`reverse_proxy` — a retry budget and a
			# connection pool each belong to one directive — so all three
			# blocks in this file carry them. See the /api handle above.
			lb_try_duration 10s
			lb_try_interval 250ms

			transport http {
				keepalive 60s
			}
		}
	}

	# Both probes must be listed. Anything not matched here falls through to the
	# SPA catch-all below, which answers `try_files ... /index.html` — so while
	# /readyz was missing it returned 200 with an HTML page no matter how sick
	# the database was, which is worse than having no readiness probe at all.
	# A named `path` matcher, because `handle` takes exactly one matcher token.
	@probes path /healthz /readyz
	handle @probes {
		reverse_proxy api:3000 {
			# Both policies are per-`reverse_proxy` — a retry budget and a
			# connection pool each belong to one directive — so all three
			# blocks in this file carry them. See the /api handle above.
			lb_try_duration 10s
			lb_try_interval 250ms

			transport http {
				keepalive 60s
			}
		}
	}

	handle {
		# Content-Security-Policy for the SPA document — the one response that
		# runs author-controlled statement HTML through `dangerouslySetInnerHTML`
		# (apps/web/src/markdown.ts sanitises it, this is the second wall).
		#
		# - `script-src 'self' 'sha256-…'`: the Vite build emits external, hashed
		#   module scripts, plus the ONE inline pre-paint theme setter D116 added
		#   to apps/web/index.html (kept inline so `data-theme` is set before the
		#   first paint — an external fetch would flash). `script-src 'self'`
		#   alone blocked it on every page (a CSP violation the browser logs, and
		#   the whole Playwright suite went red on it), so its exact sha256 is
		#   allowed — NOT `'unsafe-inline'`, so an injected `<script>` still
		#   cannot run. security-headers.spec.ts pins the hash to the file (D120).
		# - `style-src 'self' 'unsafe-inline'`: KaTeX emits inline `style="…"`
		#   attributes on every rendered formula, so inline styles must be
		#   allowed or maths renders unstyled (double MathML). This is the one
		#   concession the statement renderer forces.
		# - `img-src 'self' data: https:`: statements embed images (`![](…)`)
		#   that may be data URIs or remote https, and KaTeX/inline SVG stay
		#   same-origin.
		# - `connect-src 'self'`: the SPA calls /api and the same-origin /ws
		#   WebSocket; both are 'self'.
		# - `object-src 'none'`, `base-uri 'self'`, `frame-ancestors 'none'`,
		#   `form-action 'self'`: no plugins, no `<base>` hijack, no framing,
		#   no cross-origin form posts.
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-R/9xAxzWcnH3E29zWwBbOcYKL7O8FSm3XA5wy8dQK7c='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
